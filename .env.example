# ---- Teaching model -------------------------------------------------------
# Without any provider key, TutorOS runs in DETERMINISTIC MODE (labelled in the UI):
# the policy's default move, templated wording, no model calls.
# With a key, an LLM chooses among the moves the policy permits and writes the wording.

# anthropic | openai  (default: whichever key is set, anthropic first)
LLM_PROVIDER=
# Model id. Anthropic default: claude-haiku-5-5. Set it explicitly for OpenAI-compatible providers.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint; default https://api.openai.com/v1
OPENAI_BASE_URL=
# Per model call, in ms; one retry on transient errors (timeout, 429, 5xx)
LLM_TIMEOUT_MS=8000
# Cost cap: model calls one lesson may make; after that it continues deterministically (default 150)
LLM_MAX_CALLS_PER_SESSION=150

# Cost instrumentation, USD per million tokens. Blank = cost shown as unknown (we never guess prices).
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# ---- Sessions & safety -----------------------------------------------------
# HMAC key for signing client-held session state (32+ chars). Without it a fixed
# dev key is used and /api/health reports "degraded". REQUIRED in production.
SESSION_SECRET=
# In production, required (as the x-eval-token header) to run the LLM eval suite, since it costs money.
EVAL_TOKEN=
