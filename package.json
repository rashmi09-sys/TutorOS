{
  "name": "tutoros",
  "version": "0.1.0",
  "private": true,
  "description": "TutorOS — a teaching-policy engine and evaluation lab for 1:1 AI tutoring (proof-of-work demo).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/run-eval.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tts:smoke": "tsx scripts/tts-smoke.ts",
    "auth:hash": "tsx scripts/hash-password.ts",
    "auth:secret": "node -e \"process.stdout.write(require('crypto').randomBytes(48).toString('base64url')+'\\n')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@google-cloud/text-to-speech": "^7.1.1",
    "@vercel/oidc": "^4.0.0",
    "google-auth-library": "^11.2.0",
    "katex": "^0.18.11",
    "next": "^15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.27",
    "@playwright/test": "^1.56.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "sharp": "^0.35.5"
  }
}
